<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AccountManager.App.Views.MessageDialog"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://DshAccountManager/Assets/app.ico"
        Title="提示">
  <!-- The message scrolls when the work area is too small, so the buttons never leave the window. -->
  <Grid Margin="16,14,16,14" RowDefinitions="Auto,*,Auto">
    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,6,0" />
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="YesButton" Classes="primary" Content="确定" Click="OnYes" />
      <Button x:Name="NoButton" Classes="toolbar" Content="取消" Click="OnNo" />
    </StackPanel>
  </Grid>
</Window>
