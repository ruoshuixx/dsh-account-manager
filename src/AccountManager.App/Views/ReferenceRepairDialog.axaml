<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AccountManager.App.Views.ReferenceRepairDialog"
        Width="720" Height="640" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="avares://DshAccountManager/Assets/app.ico"
        Title="修复失效的引用">
  <Grid Margin="22" RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="6" Margin="0,0,0,12">
      <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="NoteText" Classes="subtitle" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="10" Margin="0,0,6,6">
        <StackPanel x:Name="RowList" Spacing="10" />
        <TextBlock x:Name="LockedHeader" Text="无法由本工具修改的引用（dsh 内置配置层）" FontWeight="SemiBold" IsVisible="False" Margin="0,8,0,0" />
        <StackPanel x:Name="LockedList" Spacing="4" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
      <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="ApplyButton" Classes="primary" Content="应用" Click="OnApply" />
        <Button Classes="toolbar" Content="取消" Click="OnCancel" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
