<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountManager.App.ViewModels"
        xmlns:conv="using:AccountManager.App.Converters"
        xmlns:controls="using:AccountManager.App.Controls"
        x:Class="AccountManager.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DSH 账号管理"
        Icon="avares://DshAccountManager/Assets/app.ico"
        Width="980" Height="620"
        MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- one quota window: exact-width bar + remaining %, or a plain state note -->
    <DataTemplate x:Key="QuotaCellTemplate" x:DataType="vm:QuotaCellViewModel">
      <Grid RowDefinitions="Auto,Auto" VerticalAlignment="Center" ClipToBounds="True" ToolTip.Tip="{Binding Tooltip}">
        <Grid Grid.Row="0" ColumnDefinitions="*,38">
          <controls:QuotaBar Grid.Column="0"
                             Height="5"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             Value="{Binding Percent}"
                             Track="{DynamicResource TrackBrush}"
                             TrackBorder="{DynamicResource TrackBorderBrush}"
                             Fill="{Binding Level, Converter={x:Static conv:QuotaLevelToBrushConverter.Instance}}"
                             IsVisible="{Binding HasBar}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Text}"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     FontSize="12"
                     FontWeight="SemiBold"
                     IsVisible="{Binding HasBar}"
                     Foreground="{Binding Level, Converter={x:Static conv:QuotaLevelToBrushConverter.Instance}}" />
          <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                     Text="{Binding Text}"
                     IsVisible="{Binding !HasBar}"
                     Classes="muted"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
        <TextBlock Grid.Row="1"
                   Text="{Binding ResetText}"
                   IsVisible="{Binding HasBar}"
                   Classes="muted"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,2,0,0" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImportRowTemplate" x:DataType="vm:AccountRowViewModel">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,3">
        <Grid ColumnDefinitions="30,*,80,140">
          <CheckBox Grid.Column="0" IsChecked="{Binding IsImportSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
            <TextBlock Classes="subtitle" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding PlanText}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
          <TextBlock Grid.Column="3" Text="{Binding Row.Status}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Row.Status}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AccountRowTemplate" x:DataType="vm:AccountRowViewModel">
      <!-- Every cell is clipped to its own column; the identity column is the only flexible one and trims. -->
      <Grid MinHeight="44"
            HorizontalAlignment="Stretch"
            IsVisible="{Binding IsVisible}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="*" MinWidth="140" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="128" />
          <ColumnDefinition Width="128" />
          <ColumnDefinition Width="182" />
        </Grid.ColumnDefinitions>

        <!-- selection: query quota (Codex) and/or export (saved accounts) -->
        <CheckBox Grid.Column="0"
                  IsChecked="{Binding IsQuotaSelected}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  ToolTip.Tip="勾选后：可查询额度（Codex 行）、可导出（已保存账号）" />

        <!-- account identity -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,10,4" Spacing="1" ClipToBounds="True">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="chip success" IsVisible="{Binding IsCurrent}" Margin="0,0,6,0">
              <TextBlock Text="当前" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
          </Grid>
          <TextBlock Classes="subtitle" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AccountTooltip}" />
        </StackPanel>

        <!-- subscription info: team-coloured plan badge + remaining days; wraps instead of overflowing -->
        <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,2,8,2" ClipToBounds="True" ToolTip.Tip="{Binding SubscriptionTooltip}">
          <Border Classes="chip" Background="{Binding PlanBackground}" Padding="7,1" Margin="0,1,6,1" MaxWidth="140">
            <TextBlock Text="{Binding PlanText}" Foreground="{Binding PlanForeground}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Border>
          <TextBlock Text="{Binding SubscriptionDaysText}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,1" MaxWidth="100" TextTrimming="CharacterEllipsis" />
          <Button Classes="chipAction"
                  Content="{Binding ResetCreditsText}"
                  Command="{Binding ResetCommand}"
                  IsVisible="{Binding IsCodex}"
                  Margin="0,1,0,1"
                  ToolTip.Tip="{Binding ResetCreditsTooltip}" />
        </WrapPanel>

        <ContentControl Grid.Column="3"
                        Content="{Binding Quota5h}"
                        ContentTemplate="{StaticResource QuotaCellTemplate}"
                        IsVisible="{Binding IsCodex}"
                        ClipToBounds="True"
                        VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="3" Text="—" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsApi}" />

        <ContentControl Grid.Column="4"
                        Content="{Binding QuotaWk}"
                        ContentTemplate="{StaticResource QuotaCellTemplate}"
                        IsVisible="{Binding IsCodex}"
                        ClipToBounds="True"
                        VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="4" Text="—" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsApi}" />

        <!-- actions -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="mini" Command="{Binding SwitchCommand}" IsVisible="{Binding IsCodex}" ToolTip.Tip="激活该账号为当前 DSH 凭据">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource IcoSwitch}" />
              <TextBlock Text="切号" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="mini" Command="{Binding RefreshCommand}" IsVisible="{Binding IsCodex}" ToolTip.Tip="只读查询该账号额度">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource IcoRead}" />
              <TextBlock Text="查询" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="mini" Command="{Binding ConfigureCommand}" IsVisible="{Binding IsApi}" ToolTip.Tip="编辑供应商名称、协议、地址与模型">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource IcoEdit}" />
              <TextBlock Text="配置" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="mini danger" Command="{Binding DeleteCommand}" ToolTip.Tip="真正删除凭据 / 供应商配置">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource IcoTrash}" />
              <TextBlock Text="删除" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- Zoom host: scales the whole layout down only when the work area is smaller than the designed
       minimum (see DialogWindowBounds.FitMainBounds). Without a zoom it is a pass-through. -->
  <LayoutTransformControl x:Name="ZoomHost">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- single toolbar row: list ops (left) | warning | file ops + settings (right) -->
    <Border Grid.Row="0" Classes="card" Margin="10,10,10,6" Padding="12,6,10,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <CheckBox Content="全选" IsChecked="{Binding SelectAllVisibleChecked, Mode=TwoWay}" VerticalAlignment="Center" ToolTip.Tip="全选 / 取消当前可见行" />
          <Button Classes="primary" Command="{Binding QuerySelectedCommand}" ToolTip.Tip="只读刷新勾选账号的额度">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcoRefresh}" />
              <TextBlock Text="刷新" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar danger"
                  Command="{Binding DeleteSelectedCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="删除勾选的账号或 API（每项删除前先做加密备份，需确认）">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcoTrash}" />
              <TextBlock Text="删除" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="error" Text="{Binding ProviderWarning}" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,10,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProviderWarning}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="toolbar" Command="{Binding ReadDshCommand}">
            <ToolTip.Tip>
              <StackPanel>
                <TextBlock Text="重新读取本机 DSH 账号" />
                <TextBlock Text="{Binding DshStatus}" MaxWidth="560" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </ToolTip.Tip>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IcoRead}" />
              <TextBlock Text="读取" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Command="{Binding ImportCommand}" ToolTip.Tip="解析 Cockpit 导出文件">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IcoImport}" />
              <TextBlock Text="导入" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Command="{Binding ExportCommand}" ToolTip.Tip="导出勾选的已保存账号">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IcoExport}" />
              <TextBlock Text="导出" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="设置">
            <PathIcon Data="{StaticResource IcoSettings}" />
          </Button>
          <Button Classes="primary" Command="{Binding AddAccountCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="添加账号：浏览器 OAuth 授权或添加 API 供应商">
            <PathIcon Data="{StaticResource IcoAdd}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="card" Margin="10,0,10,6" Padding="12,5" IsVisible="{Binding HasUpdate}">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Classes="primary" Content="升级并重启" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding !IsUpdating}" Margin="8,0,0,0" />
        <Button Grid.Column="2" Classes="mini" Content="取消下载" Command="{Binding CancelUpdateCommand}" IsVisible="{Binding CanCancelUpdate}" Margin="8,0,0,0" />
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="6" Margin="0,6,0,0" IsVisible="{Binding IsUpdating}" />
      </Grid>
    </Border>

    <!-- body -->
    <Border Grid.Row="2" Classes="card" Margin="10,0,10,6">
      <Grid RowDefinitions="Auto,Auto,*">

        <!-- import preview -->
        <Border Grid.Row="0"
                IsVisible="{Binding ImportPanelVisible}"
                Background="{DynamicResource ChipWarnBgBrush}"
                CornerRadius="8" Margin="8,8,8,0" Padding="10,8">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="{Binding ImportSummary}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Classes="primary" Content="确认导入" Command="{Binding CommitImportCommand}" Margin="8,0,0,0" />
              <Button Grid.Column="2" Classes="toolbar" Content="取消" Command="{Binding CancelImportCommand}" Margin="8,0,0,0" />
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="120" Margin="0,6,0,0">
              <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding ImportRows}" ItemTemplate="{StaticResource ImportRowTemplate}" />
                <TextBlock Text="{Binding ImportNotes}" Classes="subtitle" TextWrapping="Wrap" IsVisible="{Binding HasImportNotes}" />
                <ItemsControl ItemsSource="{Binding ImportRepairs}" IsVisible="{Binding ImportRepairsVisible}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportRepairViewModel">
                      <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Text}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- list header -->
        <Grid Grid.Row="1" Margin="0,6,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" MinWidth="140" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="182" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Classes="colhead" Text="选择" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Classes="colhead" Text="账号" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Classes="colhead" Text="订阅信息" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Classes="colhead" Text="5 小时窗口（剩余）" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
          <TextBlock Grid.Column="4" Classes="colhead" Text="本周窗口（剩余）" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
          <TextBlock Grid.Column="5" Classes="colhead" Text="操作" TextTrimming="CharacterEllipsis" />
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Classes="accountList" ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource AccountRowTemplate}" />
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- log panel -->
    <Border Grid.Row="3" Classes="card" Margin="10,0,10,6" Padding="8" IsVisible="{Binding LogExpanded}" MaxHeight="130">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="运行日志" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Classes="mini" Content="打开日志目录" Command="{Binding RevealLogsCommand}" />
          <Button Classes="mini" Content="清空" Command="{Binding ClearLogCommand}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,4,0,0" HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding LogLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="NoWrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- status bar: the left part wraps onto a second line instead of overflowing; the buttons stay at the right -->
    <Border Grid.Row="4" Margin="10,0,10,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="70" Height="5" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding IsWorking}" />
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" MaxWidth="360" VerticalAlignment="Center" Margin="0,2,12,2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
          <Border Classes="chip warn" IsVisible="{Binding HasUndo}" Margin="0,2,12,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UndoText}" />
              <Button Classes="chipAction" Content="撤销" Command="{Binding UndoDeleteCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="从删除前的加密备份恢复这个供应商（原 ID、Key 引用和 Key）" />
              <Button Classes="chipAction" Content="×" Command="{Binding DismissUndoCommand}" ToolTip.Tip="不再显示" />
            </StackPanel>
          </Border>
          <Border Classes="chip warn" IsVisible="{Binding HasReferenceWarning}" Margin="0,2,12,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding ReferenceWarning}" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReferenceWarning}" />
              <Button Classes="chipAction" Content="修复" Command="{Binding RepairReferencesCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="列出这些引用并选择如何修复" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding SummaryText}" Classes="subtitle" VerticalAlignment="Center" Margin="0,2,12,2" TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip.Tip="{Binding SummaryText}" />
          <TextBlock Text="{Binding CurrentText}" Classes="subtitle" VerticalAlignment="Center" Margin="0,2,12,2" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip.Tip="{Binding CurrentText}" />
        </WrapPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="mini" Content="检查更新" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !IsUpdating}" Margin="0" ToolTip.Tip="{Binding CurrentVersionText}" />
          <ToggleButton Content="日志" IsChecked="{Binding LogExpanded}" Padding="8,2" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
