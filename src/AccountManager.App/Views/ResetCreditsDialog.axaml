<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AccountManager.App.Views"
        x:Class="AccountManager.App.Views.ResetCreditsDialog"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://DshAccountManager/Assets/app.ico"
        Title="重置用量">
  <!-- The credit list scrolls (and the whole window stays inside the work area) when there is little room. -->
  <Grid Margin="16,12,16,14" RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="6">
      <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="SummaryText" Classes="subtitle" TextWrapping="Wrap" />

      <Border x:Name="TargetBanner" Classes="card" Padding="8,6">
        <TextBlock x:Name="TargetText" TextWrapping="Wrap" />
      </Border>

      <TextBlock Text="重置次数明细" FontWeight="SemiBold" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" MaxHeight="240" Margin="0,4,0,0" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="CreditsList" Margin="0,0,6,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="views:ResetCreditRow">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" CornerRadius="6" Padding="7,1" VerticalAlignment="Center"
                        Background="{Binding StatusBackground}">
                  <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                             Foreground="{Binding StatusForeground}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding GrantedText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding TitleText}" Classes="subtitle" IsVisible="{Binding HasTitle}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TitleText}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding ExpiresText}" FontSize="12.5"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="8" Margin="0,8,0,0">
      <TextBlock x:Name="HintText" Classes="subtitle" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="ConfirmButton" Classes="primary" Content="确认重置" Click="OnConfirm" />
        <Button Classes="toolbar" Content="取消" Click="OnCancel" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
